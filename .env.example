# ==============================================================================
# KrishiVaani - Environment Configuration Template
# For Railway Deployment: Configure these in Railway Dashboard -> Variables
# For Local Development: Copy this file to .env and populate actual keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Channel Integration (Phase 8.3 Long Polling) - REQUIRED
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
USER_ID_HASH_SALT=

# ------------------------------------------------------------------------------
# 2. LLM Reasoning Services (Groq default; Sarvam switchable)
# ------------------------------------------------------------------------------
LLM_PROVIDER=sarvam
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT_SECONDS=15.0
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.1
GROQ_REASONING_EFFORT=low
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_MAX_TOKENS=900
SARVAM_LENGTH_RETRY_MULTIPLIER=1.5

# ------------------------------------------------------------------------------
# 3. Speech AI Services (Gnani Prisma v3.0 STT & Timbre v2.5 TTS) - REQUIRED
# ------------------------------------------------------------------------------
GNANI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Weather Services (Phase 6.1 Integration) - REQUIRED
# ------------------------------------------------------------------------------
WEATHERAPI_API_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHER_REQUEST_TIMEOUT_SECONDS=10.0
IMD_API_KEY=
IMD_JWT_TOKEN=

# ------------------------------------------------------------------------------
# 5. Persistent Storage & Database Configuration (Railway Persistent Volume)
# ------------------------------------------------------------------------------
# Default on Railway with volume mounted at /app/data: /app/data/krishivaani.db
DATABASE_PATH=

# ------------------------------------------------------------------------------
# 6. Meta WhatsApp Cloud API (Phase 8.1 - Optional / Standby)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v27.0

# ------------------------------------------------------------------------------
# 7. Twilio WhatsApp Sandbox Integration (Phase 8.2 - Optional / Standby)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_PUBLIC_BASE_URL=
TWILIO_ENABLED=false
